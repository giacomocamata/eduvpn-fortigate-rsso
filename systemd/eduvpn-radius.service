[Unit]
Description=eduVPN RADIUS Accounting to FortiGate RSSO
Documentation=https://github.com/giacomocamata/eduvpn-fortigate-rsso
After=network-online.target eduvpn-logger.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/lib/eduvpn-radius/eduvpn-radius.py /etc/eduvpn-radius/eduvpn-radius.conf
Restart=on-failure
RestartSec=10
# Exit code 2 = configuration error: restarting would not fix it.
RestartPreventExitStatus=2
SyslogIdentifier=eduvpn-radius

# On SIGTERM the daemon sends Accounting-Stop for every active session; this
# leaves time for it even when FortiGate answers slowly.
TimeoutStopSec=30

# Runs as root, but contained: it reads a root-owned log and its config and
# writes its state, so it needs no capabilities at all.
CapabilityBoundingSet=
# /var/lib/eduvpn-radius: active sessions and the position reached in the log.
StateDirectory=eduvpn-radius
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
